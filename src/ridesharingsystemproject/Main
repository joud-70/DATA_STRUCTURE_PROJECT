package ridesharingsystemproject;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;


public class Main {

    // File names of the three CSV files (loaded automatically at startup)

    private static final String RIDERS_FILE = "riders_100.csv";
    private static final String DRIVERS_FILE = "drivers_30.csv";
    private static final String RIDES_FILE = "rides_40.csv";

    private static final BufferedReader input =
            new BufferedReader(new InputStreamReader(System.in));

    private static final IRideSharingSystem system = new RideSharingSystem();

    public static void main(String[] args) {

        // Load order matters: rides need riders and drivers to exist first

        System.out.println("Loading data...");
        report("Riders", system.loadRidersFromCSV(RIDERS_FILE), RIDERS_FILE);
        report("Drivers", system.loadDriversFromCSV(DRIVERS_FILE), DRIVERS_FILE);
        report("Rides", system.loadRidesFromCSV(RIDES_FILE), RIDES_FILE);

        int choice = -1;
        while (choice != 0) {
            printMenu();
            choice = readInt("Enter your choice: ");
            System.out.println();

            switch (choice) {
                case 1:  listAllRiders();            break;
                case 2:  searchRidersByHomeCity();   break;
                case 3:  searchRidersByName();       break;
                case 4:  addRider();                 break;
                case 5:  listAllDrivers();           break;
                case 6:  searchDriversByVehicleType(); break;
                case 7:  addDriver();                break;
                case 8:  listAllRides();             break;
                case 9:  searchRidesByPickup();      break;
                case 10: searchRidesByRiderName();   break;
                case 11: listSharedRideParticipants(); break;
                case 12: addRide();                  break;
                case 0:  System.out.println("Goodbye!"); break;
                default: System.out.println("Invalid choice. Please enter a number from 0 to 12.");
            }
            System.out.println();
        }
    }

    // ----------------
    // Menu
    // ----------------

    private static void printMenu() {
        System.out.println("========== Ride-Sharing System ==========");
        System.out.println(" 1. List all riders");
        System.out.println(" 2. Search for riders by home city");
        System.out.println(" 3. Search for riders by name");
        System.out.println(" 4. Add a rider");
        System.out.println(" 5. List all drivers");
        System.out.println(" 6. Search for drivers by vehicle type");
        System.out.println(" 7. Add a driver");
        System.out.println(" 8. List all rides alphabetically by pickup location");
        System.out.println(" 9. Search for rides by pickup location");
        System.out.println("10. Search for rides by rider name");
        System.out.println("11. List the participants of a shared ride by pickup location");
        System.out.println("12. Add a ride");
        System.out.println(" 0. Exit");
        System.out.println("=========================================");
    }

    // --------------
    // Menu operations: each one maps to one RideSharingSystem method
    // --------------

    private static void listAllRiders() {
        printList(system.getAllRiders());
    }

    private static void searchRidersByHomeCity() {
        String city = readLine("Enter home city: ");
        printList(system.searchRidersByHomeCity(city));
    }

    private static void searchRidersByName() {
        String name = readLine("Enter rider full name: ");
        printList(system.searchRidersByName(name));
    }

    private static void addRider() {
        int id = readInt("Rider ID: ");
        String name = readLine("Full name: ");
        String email = readLine("Email: ");
        String phone = readLine("Phone number (10 digits): ");
        String city = readLine("Home city: ");

        try {
            // Rider's constructor validates the phone number

            Rider rider = new Rider(id, name, email, phone, city);
            printResult(system.addRider(rider), "Rider added successfully.","Failed to add rider (duplicate ID or invalid data).");
       
} catch (IllegalArgumentException e) {
            System.out.println("Failed to add rider: " + e.getMessage());
        }
    }

    private static void listAllDrivers() {
        printList(system.getAllDrivers());
    }

    private static void searchDriversByVehicleType() {
        VehicleType type = readVehicleType();
        if (type == null) {
            return;
        }
        printList(system.searchDriversByVehicleType(type));
    }

    private static void addDriver() {
        int id = readInt("Driver ID: ");
        String name = readLine("Full name: ");
        String phone = readLine("Phone number (10 digits): ");
        String plate = readLine("Vehicle plate (3 uppercase letters + 4 digits, e.g. ABC1234): ");
        VehicleType type = readVehicleType();
        if (type == null) {
            return;
        }

        try {
            // Driver's constructor validates the phone number and the plate

            Driver driver = new Driver(id, name, phone, plate, type);
            printResult(system.addDriver(driver),"Driver added successfully.","Failed to add driver (duplicate ID, duplicate plate, or invalid data).");
        } catch (IllegalArgumentException e) {
            System.out.println("Failed to add driver: " + e.getMessage());
        }
    }

    private static void listAllRides() {
        printList(system.getAllRidesAlphabetically());
    }

    private static void searchRidesByPickup() {
        String location = readLine("Enter pickup location: ");
        printList(system.searchRidesByPickupLocation(location));
    }

    private static void searchRidesByRiderName() {
        String name = readLine("Enter rider full name: ");
        printList(system.searchRidesByRiderName(name));
    }

    private static void listSharedRideParticipants() {
        String location = readLine("Enter pickup location of the shared ride: ");
        printList(system.getSharedRideParticipants(location));
    }

    private static void addRide() {
        String type = readLine("Is the ride private or shared? (P = private, S = shared): ").toUpperCase();
        boolean isPrivate;
        if (type.equals("P") || type.equals("PRIVATE")) {
            isPrivate = true;
        } else if (type.equals("S") || type.equals("SHARED")) {
            isPrivate = false;
        } else {
            System.out.println("Invalid ride type. Ride was not added.");
            return;
        }

        String pickupLocation = readLine("Pickup location: ");
        IDateTime pickupTime = readDateTime("Pickup date/time (MM/DD/YYYY HH:MM): ");
        if (pickupTime == null) {
            return;
        }
        IDateTime dropoffTime = readDateTime("Drop-off date/time (MM/DD/YYYY HH:MM): ");
        if (dropoffTime == null) {
            return;
        }
        String dropoffLocation = readLine("Drop-off location: ");
        int driverId = readInt("Driver ID: ");

        boolean scheduled;
        if (isPrivate) {
            int riderId = readInt("Rider ID: ");
            scheduled = system.schedulePrivateRide(pickupLocation, pickupTime,dropoffTime, dropoffLocation, riderId, driverId);
        } else {
            int[] riderIds = readRiderIds();
            if (riderIds == null) {
                return;
            }
            scheduled = system.scheduleSharedRide(pickupLocation, pickupTime,dropoffTime, dropoffLocation, riderIds, driverId);
        }

        printResult(scheduled,"Ride scheduled successfully.","Failed to schedule ride (rider/driver not found, invalid times, or schedule conflict).");
    }

    // ------------------------------------------------------------------
    // Output helpers
    // ------------------------------------------------------------------

    /** Prints every element's toString(), one per line, or a "no results" message. */
    private static <T> void printList(LinkedList<T> list) {
        if (list == null || list.empty()) {
            System.out.println("No results found.");
            return;
        }
        list.findFirst();
        while (true) {
            System.out.println(list.retrieve());
            if (list.last()) {
                break;
            }
            list.findNext();
        }
    }

    private static void printResult(boolean success, String successMsg, String failMsg) {
        System.out.println(success ? successMsg : failMsg);
    }

    private static void report(String what, boolean loaded, String file) {
        if (loaded) {
            System.out.println(what + " loaded from " + file);
        } else {
            System.out.println("Could not load " + what.toLowerCase() + " from " + file + " (make sure the file is in the working directory).");
        }
    }

    // ----------------
    // Input helpers
    // ----------------

    /** Reads one trimmed line. Exits cleanly if the input stream ends. */

    private static String readLine(String prompt) {
        System.out.print(prompt);
        try {
            String line = input.readLine();
            if (line == null) {
// end of input (e.g. Ctrl+D)
                System.out.println();
                System.out.println("Input ended. Exiting.");
                System.exit(0);
            }
            return line.trim();
        } catch (IOException e) {
            System.out.println("Error reading input. Exiting.");
            System.exit(1);
        }
        return "";
    }

    /** Keeps asking until the user enters a valid integer. */

    private static int readInt(String prompt) {
        while (true) {
            String text = readLine(prompt);
            try {
                return Integer.parseInt(text);
            } catch (NumberFormatException e) {
                System.out.println("Please enter a valid whole number.");
            }
        }
    }

    /** Reads a vehicle type; accepts "LUXURY SEDAN" or "LUXURY_SEDAN". Returns null if invalid. */

    private static VehicleType readVehicleType() {
        String text = readLine("Vehicle type (SEDAN, LUXURY_SEDAN, SUV, VAN): ");
        try {
            return VehicleType.valueOf(text.toUpperCase().replace(' ', '_'));
        } catch (IllegalArgumentException e) {
            System.out.println("Invalid vehicle type. Operation cancelled.");
            return null;
        }
    }

    /** Reads a date/time in the format MM/DD/YYYY HH:MM. Returns null if invalid. */

    private static IDateTime readDateTime(String prompt) {
        String text = readLine(prompt);
        try {
            String[] parts = text.split("\\s+");
            String[] date = parts[0].split("/");
            String[] time = parts[1].split(":");
            return new DateTime(Integer.parseInt(date[2]), Integer.parseInt(date[0]),
                    Integer.parseInt(date[1]), Integer.parseInt(time[0]),
                    Integer.parseInt(time[1]));
        } catch (RuntimeException e) {
// bad format or out-of-range values
            System.out.println("Invalid date/time. Use the format MM/DD/YYYY HH:MM. Ride was not added.");
            return null;
        }
    }

    /**
     * Reads the rider IDs of a shared ride (separated by semicolons, commas or spaces).
     * A shared ride needs more than one rider Returns null if the input is invalid.
     */

    private static int[] readRiderIds() {
        String text = readLine("Rider IDs (more than one, separated by ';'): ");
        String[] tokens = text.replace(',', ';').replace(' ', ';').split(";");

        // First pass: count the non-empty tokens

        int count = 0;
        for (int i = 0; i < tokens.length; i++) {
            if (!tokens[i].isEmpty()) {
                count++;
            }
        }
        if (count < 2) {
            System.out.println("A shared ride needs more than one rider. Ride was not added.");
            return null;
        }

        // Second pass: convert them to integers

        int[] ids = new int[count];
        int index = 0;
        for (int i = 0; i < tokens.length; i++) {
            if (tokens[i].isEmpty()) {
                continue;
            }
            try {
                ids[index++] = Integer.parseInt(tokens[i]);
            } catch (NumberFormatException e) {
                System.out.println("Invalid rider ID: " + tokens[i] + ". Ride was not added.");
                return null;
            }
        }
        return ids;
    }
}
